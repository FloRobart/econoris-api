# Comments stay on their own line: after an empty value, Compose would read them as the value

# Application configuration
# Host (example: "localhost")
HOST_NAME=0.0.0.0
# Exposed port for Econoris API in development (example: 8080)
APP_PORT=26002
# URL where the API is available --> "http://${HOST_NAME}:${APP_PORT}"
BASE_URL="http://localhost:26002"
# Environment (dev, prod, silent) used to print more or less logs in console and expose Swagger endpoint
APP_ENV=dev
# Format of the logs generated by morgan middleware (example: combined, common, dev, short, tiny)
LOG_FORMAT=combined

# Database
# Database scheme (postgresql, mysql, etc.)
DB_SCHEME=postgresql
# User for Econoris DB (same value as DB_USER in the econoris-database repository)
DB_USER=econoris
# Hostname of the database service in Docker network
DB_HOST=econoris-db
# Database name for Econoris DB
DB_NAME=econoris

# Email
# Email service provider (example: gmail)
MAIL_SERVICE=gmail
# Email account
MAIL_USERNAME=

# Rate Limiting
# Number of requests allowed per second and per IP (example: 10)
REQUEST_LIMIT_PER_SECOND=10
# Time window to count requests in seconds (example: same value as JWT_EXPIRATION)
REQUEST_LIMIT_TIME=30min

# Authentication
# URL of the authentication application
AUTH_APP_URL="http://localhost:26001"

# CORS
# List of allowed domains to make requests to the API (separated by commas)
CORS_ALLOWED_ORIGINS="http://localhost:26003"

# Secrets, development only. Commented out so they never reach a production .env:
# production reads them from files (see docker-compose.yml).
# In development, docker-compose.dev.yml gives DB_PASSWORD a default value.
# DB_PASSWORD=postgres
# MAIL_PASSWORD=
