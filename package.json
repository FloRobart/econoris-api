{
  "name": "econoris-api",
  "version": "2.2.3",
  "description": "Éconoris est une application web de gestion de finances personnelles.",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "dev-docker": "docker compose -f docker-compose.dev.yml up --build",
    "clean": "rm -rf dist",
    "clean-docker": "docker compose -f docker-compose.dev.yml down --volumes --rmi all",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloRobart/econoris-api.git"
  },
  "author": "FloRobart",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/FloRobart/econoris-api/issues"
  },
  "homepage": "https://github.com/FloRobart/econoris-api#readme",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.6",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "ms": "2.1.3",
    "node-cron": "4.6.0",
    "nodemailer": "10.2.1",
    "path": "0.12.7",
    "pg": "8.23.1",
    "strftime": "0.10.3",
    "zod": "4.6.7"
  }
}
